# =============================================================================
# Autonomous Graph-RAG Agent — Environment Configuration
# =============================================================================

# Service Settings
APP_NAME=autonomous-graph-rag-agent
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# LLM Provider Configuration (openai | anthropic | ollama | vllm | mock)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Embedding & Reranker Models
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=BAAI/bge-reranker-large
USE_LIGHTWEIGHT_EMBEDDINGS=false

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise_knowledge_chunks
QDRANT_IN_MEMORY=false

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_enterprise_pass
NEO4J_DATABASE=neo4j

# Agentic Workflow Settings
MAX_RETRIES=2
RELEVANCE_THRESHOLD=0.65
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_RERANK=5
RRF_K=60
GRAPH_MAX_HOPS=2
